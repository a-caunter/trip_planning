{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Trip planner portable trip v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "trip"],
  "properties": {
    "format": { "const": "trip-planner" },
    "version": { "const": 1 },
    "trip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "tripStartDate", "currency", "destinations"],
      "properties": {
        "title": { "type": "string", "pattern": "\\S", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 10000 },
        "tripStartDate": {
          "type": "string",
          "format": "date",
          "description": "Real calendar date YYYY-MM-DD; first destination starts here."
        },
        "currency": { "enum": ["USD", "EUR", "GBP", "CAD", "AUD", "JPY"] },
        "destinations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/definitions/destination" },
          "description": "Ordered stops. Total duration must not exceed 520 weeks."
        }
      }
    }
  },
  "definitions": {
    "amount": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1000000000,
      "multipleOf": 0.01,
      "description": "Whole-party estimate in trip currency, up to two decimals. Null means unknown; zero means no expected cost."
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "durationWeeks"],
      "properties": {
        "name": { "type": "string", "pattern": "\\S", "maxLength": 200 },
        "durationWeeks": { "type": "integer", "minimum": 1, "maximum": 520 },
        "notes": { "type": "string", "maxLength": 10000 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "costs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "flights": {
              "$ref": "#/definitions/amount",
              "description": "One-time flight costs assigned to this stop."
            },
            "lodgingPerNight": {
              "$ref": "#/definitions/amount",
              "description": "Nightly lodging rate; seven nights per week."
            },
            "foodPerDay": {
              "$ref": "#/definitions/amount",
              "description": "Daily food rate; seven days per week."
            },
            "transport": {
              "$ref": "#/definitions/amount",
              "description": "One-time ground transport/transfer total for this stop."
            },
            "misc": {
              "$ref": "#/definitions/amount",
              "description": "One-time miscellaneous spending total for this stop."
            }
          }
        }
      }
    }
  }
}
